#!/bin/sh
# Removes AI attribution lines from every commit message (see CLAUDE.md). Turn on once per clone:
#   git config core.hooksPath .githooks
f="$1"
tmp="$f.tmp.$$"
grep -viE '^(co-authored-by:.*(claude|anthropic|openai|copilot|chatgpt|gemini)|claude-session:|.*generated with \[?claude)' "$f" > "$tmp"
# drop trailing blank lines left behind
awk 'NF{for(;n>0;n--)print "";print;next}{n++}' "$tmp" > "$f"
rm -f "$tmp"
